# 校园交易平台 - 环境变量配置模板
# 复制此文件为 .env 并根据实际情况修改配置

# ===========================================
# 数据库配置
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=campus_user
DB_PASSWORD=campus_trade_2024
DB_NAME=campus_trade

# ===========================================
# JWT配置
# ===========================================
JWT_SECRET=campus_trade_jwt_secret_key_2024_production_environment

# ===========================================
# 应用配置
# ===========================================
NODE_ENV=production
PORT=3000
BASE_URL=http://your-server-ip:3000
ALLOWED_ORIGINS=http://your-server-ip:80,http://your-server-ip:3000

# ===========================================
# 前端配置
# ===========================================
# 前端端口
VITE_PORT=5173
# API 服务器地址（开发环境）
VITE_API_TARGET=http://localhost:3000
# 图片基础URL（生产环境）
VITE_BASE_URL=http://your-server-ip:3000
# API 基础路径
VITE_API_URL=/api

# ===========================================
# 服务器信息（部署脚本会自动设置）
# ===========================================
SERVER_IP=your-server-ip
SERVER_HOSTNAME=your-server-hostname

# ===========================================
# 邮件配置（需要根据实际情况修改）
# ===========================================
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your_email@qq.com
SMTP_PASS=your_email_password

# ===========================================
# 邮箱验证与限流
# ===========================================
# 注册时是否强制校验邮箱验证码
# 默认（不填）：配置了 SMTP 就自动开启；未配置邮件服务则自动豁免
# 设置为 true / false 可强制覆盖
#REQUIRE_EMAIL_VERIFICATION=true

# 部署在 Nginx 等反向代理后面时，填代理层数（默认 1）
# 用于限流正确获取客户端真实 IP；直接曝露服务时设为 false
#TRUST_PROXY=1

# 需要关闭限流时设为 true（如已有网关层限流）
#RATE_LIMIT_DISABLED=false

# ===========================================
# AI 助手（可选）
# ===========================================
# 配置后启用「小易」AI 助手：悬浮聊天（商品搜索/订单查询）+ AI 写文案
# 不配置 AI_API_KEY 时功能自动关闭，不影响其他部分
#
# 支持任意 OpenAI 兼容接口：
#   DeepSeek:   https://api.deepseek.com/v1            deepseek-chat
#   通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1  qwen-plus
#   Kimi:       https://api.moonshot.cn/v1             moonshot-v1-8k
#   智谱 GLM:   https://open.bigmodel.cn/api/paas/v4   glm-4-flash
#AI_API_KEY=sk-xxxx
#AI_BASE_URL=https://api.deepseek.com/v1
#AI_MODEL=deepseek-chat
#
# 以下为高级选项（不填有默认值）：
#AI_MAX_TOKENS=1024          # 单次回复最大 token
#AI_MAX_TOOL_ROUNDS=4        # 工具调用最大轮数
#AI_TIMEOUT_MS=60000         # 请求超时
#AI_MAX_HISTORY=20           # 会话保留历史条数

# ===========================================
# 其他配置
# ===========================================
# 上传文件大小限制（字节）
MAX_FILE_SIZE=10485760

# 会话超时时间（秒）
SESSION_TIMEOUT=3600
